###############################################
# 6. PROTECTED ROUTES TESTING
###############################################

### Access Protected Route - WITH Valid Token
# Example: Get user's bookings (requires authentication)
GET {{baseUrl}}/bookings/customer/9
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjE3LCJlbWFpbCI6InRlc3RmbG93QGV4YW1wbGUuY29tIiwicm9sZUlkIjo2LCJyb2xlTmFtZSI6IkN1c3RvbWVyIiwiaWF0IjoxNzcyODA2ODM2LCJleHAiOjE3NzM0MTE2MzZ9.lYabWZ-Mn6pjG-XVFet8jl6pD-D6u54H5TJb41Pcc1c

### Access Protected Route - WITHOUT Token (Should Fail with 401)
GET {{baseUrl}}/bookings/customer/9
Accept: {{contentType}}

### Access Admin Route - WITH Customer Token (Should Fail with 403)
# Customer trying to access admin-only user management
GET {{baseUrl}}/users
Authorization: Bearer customer_token_here
Accept: {{contentType}}

### Access Admin Route - WITH Admin Token (Should Succeed)
GET {{baseUrl}}/users
Authorization: Bearer admin_token_here
Accept: {{contentType}}

###############################################
# 7. COMPLETE LOGIN FLOW TEST
###############################################

### Step 1: Register New User
# @name register
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "firstName": "TestFlow",
  "lastName": "User",
  "email": "testflow@example.com",
  "password": "FlowTest123!",
  "phone": "+254700111222"
}

### Step 2: Login with New User
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "testflow@example.com",
  "password": "FlowTest123!"
}

### Step 3: Verify Token (use token from Step 2)
GET {{baseUrl}}/auth/verify
Authorization: Bearer {{login.response.body.token}}

### Step 4: Access Protected Resource (use token from Step 2)
GET {{baseUrl}}/bookings/customer/{{login.response.body.user.UserId}}
Authorization: Bearer {{login.response.body.token}}
Accept: {{contentType}}

### Step 5: Change Password
POST {{baseUrl}}/auth/change-password
Content-Type: {{contentType}}

{
  "userId": {{login.response.body.user.UserId}},
  "currentPassword": "FlowTest123!",
  "newPassword": "NewFlowTest456!"
}

### Step 6: Login with New Password
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "testflow@example.com",
  "password": "NewFlowTest456!"
}

### Step 7: Logout
POST {{baseUrl}}/auth/logout
Content-Type: {{contentType}}

###############################################
# NOTES
###############################################

# Payment Methods IDs:
# 1 = Cash
# 2 = Card
# 3 = M-Pesa
# 4 = Bank Transfer

# Payment Status IDs:
# 1 = Pending
# 2 = Completed
# 3 = Failed
# 4 = Refunded

# Booking Status IDs:
# 1 = Pending
# 2 = Confirmed
# 3 = InProgress
# 4 = Completed
